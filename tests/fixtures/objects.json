{
 "actions": [
  {
   "description": "Build a timelapse from the archive: a rolling range (12h, 24h, 7d, 1mo) or a span of your own, with how to render it. Built one at a time; the timelapse sensor says what happened.",
   "fields": {
    "end": {
     "description": "End of that span; now if left out.",
     "type": "datetime"
    },
    "every": {
     "default": 1,
     "description": "Use every Nth still: 2 halves the length.",
     "max": 1000,
     "min": 1,
     "type": "int"
    },
    "fps": {
     "default": 15,
     "description": "Frames of video per second; each still is one frame.",
     "max": 60,
     "min": 1,
     "type": "int"
    },
    "name": {
     "description": "Name for a span of your own: up to 48 of a-z, 0-9, _ and -.",
     "type": "str"
    },
    "quality": {
     "default": 23,
     "description": "x264 CRF: lower is sharper and bigger.",
     "max": 40,
     "min": 15,
     "type": "int"
    },
    "range": {
     "description": "A rolling range ending now, rebuilt as last_<range>. Give this or start.",
     "options": [
      "12h",
      "24h",
      "7d",
      "1mo"
     ],
     "type": "select"
    },
    "start": {
     "description": "Start of a span of your own, ISO 8601; without a zone it is the service's local time.",
     "type": "datetime"
    },
    "width": {
     "description": "Width in pixels, even; the stills' own if left out.",
     "max": 3840,
     "min": 160,
     "type": "int"
    }
   },
   "name": "build_timelapse"
  },
  {
   "description": "Delete a built timelapse by name.",
   "fields": {
    "name": {
     "description": "The timelapse to delete.",
     "type": "str"
    }
   },
   "name": "delete_timelapse"
  }
 ],
